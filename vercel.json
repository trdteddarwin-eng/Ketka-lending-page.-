{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/delivered", "destination": "/delivered.html" },
    { "source": "/skills", "destination": "/skills.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/dental-ai-receptionist-case-study", "destination": "/blog/dental-ai-receptionist-case-study.html" },
    { "source": "/blog/ai-follow-up-emails-case-study", "destination": "/blog/ai-follow-up-emails-case-study.html" },
    { "source": "/blog/ai-chatbot-case-study", "destination": "/blog/ai-chatbot-case-study.html" },
    { "source": "/blog/ai-lead-generation-case-study", "destination": "/blog/ai-lead-generation-case-study.html" },
    { "source": "/blog/ai-email-reply-case-study", "destination": "/blog/ai-email-reply-case-study.html" },
    { "source": "/blog/whatsapp-ai-agent-case-study", "destination": "/blog/whatsapp-ai-agent-case-study.html" },
    { "source": "/blog/plumber-ai-chatbot-case-study", "destination": "/blog/plumber-ai-chatbot-case-study.html" },
    { "source": "/blog/insurance-ai-lead-generation-case-study", "destination": "/blog/insurance-ai-lead-generation-case-study.html" },
    { "source": "/blog/auto-repair-voice-ai-case-study", "destination": "/blog/auto-repair-voice-ai-case-study.html" },
    { "source": "/demo", "destination": "/demo/index.html" }
  ]
}
